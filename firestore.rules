rules_version = '2';

// Firestore security rules for the wedding app.
// ─────────────────────────────────────────────────────────────────────────
// Deploy with:  npm run firebase:rules
//
// Nothing in this app talks to Firestore from a browser. Every read and write
// goes through a Next.js API route using the Admin SDK and a service account,
// and those routes decide what the caller is allowed to see — a guest can
// resolve their own invite code, an admin with the session cookie can reach
// everything else.
//
// So the correct client-side rule set is: deny everything. A denial here is
// not a bug to work around; it means something is trying to reach the database
// directly from a browser, which is exactly what these rules exist to stop.
//
// This is a real improvement on the Supabase setup it replaced, where the anon
// key sitting in the page source could read all 261 guest records, their
// dietary requirements and their check-in times.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
