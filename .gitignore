# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.production

# firebase
firebase-debug.log
firestore-debug.log
.vercel
.env*.local

# Env template is safe to commit; real secrets are not.
!.env.example

# Service account keys — never commit. These grant full admin access to the
# Firebase project (read/write every collection, bypassing security rules).
*service-account*.json
*serviceAccount*.json
firebase-adminsdk-*.json
/secrets/

# Local-only: contains the service account for pasting into the host.
VERCEL_ENV_SETUP.txt
