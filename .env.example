# Copy to .env.local and fill in. Never commit .env.local.

# ── Google Drive: the media store ────────────────────────────────────────
# Guest photos are written into a folder in the couple's own Google Drive.
# Create the OAuth client (Google Cloud Console → Drive API + OAuth client,
# redirect URI http://localhost:53682/callback), put the id/secret here, then
# run `npm run drive:auth` to mint the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional. Left blank, the app creates and reuses a folder called
# "Wedding Media" on first upload. Set this to pin a specific folder id.
GDRIVE_MEDIA_FOLDER_ID=
# Optional. Renames the auto-created folder.
GDRIVE_MEDIA_FOLDER_NAME=Wedding Media

# ── Firebase / Firestore: everything that isn't media ────────────────────
# Guests, RSVPs, seating, timeline, playlist, registry, budget, vendors,
# well wishes, and both config documents.
#
# Only the service account is needed. Nothing talks to Firestore from a
# browser — firestore.rules denies that outright — so there is no public
# Firebase web config to set. Get the key from Firebase Console →
# Project settings → Service accounts → Generate new private key, then:
#   node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=

# Optional. Overrides the project the client config points at.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Local development only: point at the Firestore emulator instead of the real
# project. `npm run firebase:emulator` starts it. Leave unset in production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8099

# ── Admin access ─────────────────────────────────────────────────────────
# Unlock the dashboard with /admin?adminKey=YOUR_KEY
ADMIN_ACCESS_KEY=
# Optional comma-separated list for shared admin access.
ADMIN_ACCESS_KEYS=

# Optional per-family seating links: /family/<key>
FAMILY_ACCESS_KEY_BRIDE=
FAMILY_ACCESS_KEY_GROOM=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
